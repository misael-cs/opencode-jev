{
  "name": "@misaelcs/opencode-jev",
  "version": "2.0.1",
  "description": "JEV Orchestrator plugin for OpenCode — O(1) intra-loop tool routing via Typesafe JEV on OpenRouter",
  "type": "module",
  "main": "./dist/src/plugin.js",
  "bin": {
    "opencode-jev": "dist/bin/cli.js",
    "opencode-jev-orchestrator": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check": "biome check --write && npm run typecheck",
    "test": "vitest run",
    "dev": "tsx watch bin/cli.ts panel",
    "changeset": "changeset",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "jev",
    "openrouter",
    "typesafe",
    "routing",
    "agent",
    "orchestrator"
  ],
  "author": "misael-cs",
  "license": "MIT",
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misael-cs/opencode-jev.git"
  },
  "homepage": "https://github.com/misael-cs/opencode-jev#readme",
  "bugs": {
    "url": "https://github.com/misael-cs/opencode-jev/issues"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "systray2": "^2.1.4"
  }
}
