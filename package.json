  "description": "JEV Orchestrator plugin for OpenCode — O(1) intra-loop tool routing via Typesafe JEV on OpenRouter",
  "type": "module",
  "main": "./dist/src/plugin.js",
  "bin": {
    "opencode-jev": "dist/bin/cli.js",
