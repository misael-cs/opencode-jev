  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misael-cs/opencode-jev.git"
  },
  "homepage": "https://github.com/misael-cs/opencode-jev#readme",
  "bugs": {
    "url": "https://github.com/misael-cs/opencode-jev/issues"
